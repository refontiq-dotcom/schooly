# Copier en .env.local (à la racine ET/OU dans l'app concernée) et renseigner.

# ---------------------------------------------------------------- Supabase --
# Local (stack schooly-v2) : `npm run db:start` puis récupérer les clés avec
# `cd packages/db && supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Apps ------
# Admin (direction, compta, caisse, pédagogie) — port 3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3000
# PWA Parent — port 3001
NEXT_PUBLIC_PARENT_APP_URL=http://localhost:3001

# -------------------------------------------------------- Billing Refontiq ---
# Secret partagé du push métriques : doit être IDENTIQUE dans le Control Center
# (METRICS_PUSH_SECRET). `npm run billing:metrics -- --dry-run` pour vérifier
# l'agrégation sans pousser.
METRICS_PUSH_SECRET=
# URL du Control Center (cible du push) — défaut http://localhost:3000 en dev
CONTROL_CENTER_URL=http://localhost:3000

# Paiement Wave
WAVE_MERCHANT_ID=
NEXT_PUBLIC_WAVE_PAY_URL=https://pay.wave.com/m/M_ci_RImDyQYI8ccj/c/ci/
# Secret du webhook Wave (défini quand l'API Wave sera disponible)
WAVE_WEBHOOK_SECRET=

# Telegram REFONTIQ centralisé (alertes validation / rejet / critique)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_URL=https://admin.schooly.ci/billing

# ------------------------------------------------------------ Intégrations --
# Sentry (observabilité, Phase 0) — laisser vide tant qu'aucun DSN n'est fourni,
# le logger structuré interne reste le fallback.
SENTRY_DSN=

# Clé partenaire API Trouvetou (Phase 10)
TROUVETOU_API_KEY_PEPPER=
TROUVETOU_API_KEY=
# Connecteur écosystème (Étape 10) : push HTTP vers l'API Trouvetou
TROUVETOU_SYNC_URL=
TROUVETOU_INSTANCE_URL=https://admin.schooly.ci

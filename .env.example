# Copier ce fichier en .env.local et renseigner les valeurs.

# Projet Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role — usage serveur uniquement, JAMAIS exposée au client
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Connexion Postgres directe (migrations/DDL uniquement, pas utilisée par l'app)
DATABASE_URL=

# Clé partenaire pour l'API Trouvetou (sera utilisée par /api/trouvetou)
TROUVETOU_API_KEY_PEPPER=

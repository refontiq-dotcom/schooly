# Copier en .env.local (à la racine ET/OU dans l'app concernée) et renseigner.

# ---------------------------------------------------------------- Supabase --
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Apps ------
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_PARENT_APP_URL=http://localhost:3001

# -------------------------------------------------------- Billing Refontiq ---
# Secret partagé entre Schooly et Refontiq Control Center.
METRICS_PUSH_SECRET=
# En production : URL publique du Control Center.
CONTROL_CENTER_URL=https://refontiq-control-center.vercel.app

# Paiement Wave
WAVE_MERCHANT_ID=
NEXT_PUBLIC_WAVE_PAY_URL=https://pay.wave.com/m/M_ci_RImDyQYI8ccj/c/ci/
WAVE_WEBHOOK_SECRET=

# Telegram Refontiq centralisé (alertes vers le Super Admin + miroir Control Center)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_URL=https://admin.schooly.ci/billing

# ------------------------------------------------------------ Intégrations --
SENTRY_DSN=
TROUVETOU_API_KEY_PEPPER=
TROUVETOU_API_KEY=
TROUVETOU_SYNC_URL=
TROUVETOU_INSTANCE_URL=https://admin.schooly.ci

# ------------------------------------------------- Outbox / Notifications ---
# Secret partagé des routes cron (garde Bearer). À définir aussi côté Vercel.
# Tant qu'il est vide, /api/cron/outbox-drain refuse toute requête (401).
CRON_SECRET=

# Worker outbox (P2-1). Sans provider configuré, le drain tourne en mode
# PREVIEW : le message rendu est stocké dans error_message, aucun envoi réel.
# API WhatsApp Cloud (Meta) — à renseigner quand l'envoi réel sera branché :
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Taille du batch drainé par exécution (1-100, défaut 25) :
OUTBOX_BATCH_SIZE=25
